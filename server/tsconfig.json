{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "paths": {
      "../../../shared": ["shared/index"],
      "../../shared": ["shared/index"],
      "../shared": ["shared/index"],
      "@shared": ["shared/index"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*"]
}
