# Server configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_room_jwt_key_987654321

# Database (SQLite by default for zero-config local run, or postgres://user:pass@host:5432/roomdb)
DATABASE_URL="file:./dev.db"

# Storage Provider: 'local' (built-in zero-credential dev storage) or 's3' / 'r2'
STORAGE_PROVIDER=local

# S3 / Cloudflare R2 Settings (Only needed if STORAGE_PROVIDER is s3 or r2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=room-audio-bucket
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# PUBLIC_STORAGE_URL=https://cdn.yourdomain.com
