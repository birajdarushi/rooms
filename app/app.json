{
  "expo": {
    "name": "Room",
    "slug": "room-synced-listening",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0b0d17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.room.listeningparty",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.room.listeningparty",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d17"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-asset"
    ]
  }
}
